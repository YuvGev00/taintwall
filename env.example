# Copy to .env.gemini and .env.openrouter (both gitignored by .env.*). Never commit real keys.
# Use: uv run --env-file .env.gemini python -m taintwall.eval.run_agentdojo --provider openai-compatible ...
#
# .env.gemini
#   TAINTWALL_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   TAINTWALL_API_KEY=<Google AI Studio key>
# .env.openrouter
#   TAINTWALL_BASE_URL=https://openrouter.ai/api/v1
#   TAINTWALL_API_KEY=<OpenRouter key>
TAINTWALL_BASE_URL=
TAINTWALL_API_KEY=
